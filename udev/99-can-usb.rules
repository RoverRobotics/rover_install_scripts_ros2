# Install: sudo cp 99-can-usb.rules /etc/udev/rules.d/99-can-usb.rules && sudo udevadm control --reload-rules
# Then unplug/replug the USB-CAN adapter (or reboot) to apply the rename.
#
# Gives the gs_usb USB-CAN adapter (VID 1d50 / PID 606f: CANable,
# candleLight, InnoMaker USB2CAN V3.3) the stable name "rovercan".
#
# The kernel canN name is not stable: on the Jetson AGX Orin the two onboard
# mttcan controllers and the USB adapter race for can0/can1/can2 at boot, so
# anything pinned to canN can bind to an unwired onboard controller instead.
#
# "rovercan" matches enablecan, can-watchdog and the driver's device_port.
SUBSYSTEM=="net", ACTION=="add", ATTRS{idVendor}=="1d50", ATTRS{idProduct}=="606f", NAME="rovercan"
